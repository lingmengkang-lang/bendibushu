(* -------------------------------------------------------------------
   示例 1：电机启停自保持 + 急停 + 安全联锁
   ------------------------------------------------------------------- *)
VAR
    Start_PB     : BOOL;   (* 启动按钮 *)
    Stop_PB      : BOOL;   (* 停止按钮 *)
    EStop        : BOOL;   (* 急停信号，常闭：0 = 急停生效 *)
    Interlock_OK  : BOOL;   (* 安全联锁条件（如防护门、流量、压力正常）*)
    Fault        : BOOL;   (* 故障标志 *)
    Motor_Run    : BOOL;   (* 电机运行输出 *)
END_VAR

IF Stop_PB OR (NOT EStop) OR Fault THEN
    Motor_Run := FALSE;            (* 停止 / 急停 / 故障 优先级最高，立即断 *)
ELSIF Start_PB AND Interlock_OK THEN
    Motor_Run := TRUE;             (* 启动需联锁条件满足 *)
END_IF;


(* -------------------------------------------------------------------
   示例 2：定时器(TON) 延时启动
   ------------------------------------------------------------------- *)
VAR
    TON1     : TON;                (* 标准接通延时定时器功能块 *)
    Enable   : BOOL;
    Delay_PT : TIME := T#2S;       (* 延时 2 秒 *)
    Delayed  : BOOL;
END_VAR

TON1(IN := Enable, PT := Delay_PT);
Delayed := TON1.Q;


(* -------------------------------------------------------------------
   示例 3：计数器(CTU) 产品计数
   ------------------------------------------------------------------- *)
VAR
    CTU1     : CTU;                (* 加计数器 *)
    Count_PV : INT := 100;         (* 目标计数 100 *)
    Pulse    : BOOL;               (* 每来一个产品置位一次 *)
    Done     : BOOL;
END_VAR

CTU1(CU := Pulse, PV := Count_PV, R := FALSE);
Done := CTU1.Q;


(* -------------------------------------------------------------------
   示例 4：PID 调用（标准 PID 功能块示意）
   注意：Kp/Ki/Kd 必须结合实际对象现场整定，切勿照搬
   ------------------------------------------------------------------- *)
VAR
    Pid1      : PID;               (* 各厂商/库提供的 PID 功能块名不同 *)
    Setpoint  : REAL := 50.0;      (* 设定值 *)
    Feedback  : REAL;              (* 过程反馈（如温度/压力/转速）*)
    Output    : REAL;
END_VAR

Pid1(
    Setpoint := Setpoint,
    Feedback := Feedback,
    Kp := 1.2, Ki := 0.4, Kd := 0.0,
    Output => Output
);


(* -------------------------------------------------------------------
   示例 5：伺服/步进 脉冲定位（示意，具体指令随品牌差异大）
   ------------------------------------------------------------------- *)
VAR
    Axis_Enable : BOOL;            (* 轴使能 *)
    Home_Done   : BOOL;            (* 原点回归完成 *)
    Move_Cmd    : BOOL;            (* 定位启动 *)
    Pos_Target  : DINT;            (* 目标位置 脉冲数 *)
    In_Position : BOOL;            (* 到位信号 *)
END_VAR

(* 伪代码思路（非某品牌专用指令）：
   IF Axis_Enable THEN 使能伺服;
   IF NOT Home_Done THEN 执行回零;
   ELSIF Move_Cmd THEN 按 Pos_Target 发脉冲定位;
   In_Position := (实际位置 = Pos_Target);
   实际请用各品牌运动控制指令（如 MC_MoveAbsolute 等 PLCopen 标准 FB）*)
